{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fora-do-abismo.local/schemas/jarvis-actor-v9.schema.json",
  "title": "Jarvis Actor Payload V9",
  "$defs": {
    "imgStrategy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": { "type": "string", "enum": ["foundry", "generate", "custom"], "default": "foundry" },
        "iconKey": { "type": "string", "minLength": 1 },
        "customPath": { "type": "string", "minLength": 1 },
        "promptHints": { "type": "array", "items": { "type": "string", "minLength": 1 }, "default": [] },
        "tags": { "type": "array", "items": { "type": "string", "minLength": 1 }, "default": [] },
        "semanticRole": { "type": "string", "minLength": 1 },
        "style": { "type": "string", "minLength": 1 },
        "fallbackIcon": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "source": { "const": "custom" } }, "required": ["source"] },
          "then": { "required": ["customPath"] }
        }
      ]
    },
    "uses": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "max": { "type": ["string", "number", "null"] },
        "spent": { "type": ["number", "string"] },
        "recovery": {
          "oneOf": [
            { "type": "string" },
            { "type": "object" },
            { "type": "array", "items": { "oneOf": [{ "type": "string" }, { "type": "object" }] } }
          ]
        }
      }
    },
    "activity": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": true,
      "properties": {
        "_id": { "type": "string" },
        "name": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["attack", "save", "utility", "heal", "check", "damage", "summon", "enchant", "cast", "forward"]
        },
        "img": { "type": "string" },
        "activation": { "type": "object" },
        "consumption": {
          "type": "object",
          "properties": {
            "targets": { "type": "array", "items": { "type": "object" } },
            "scaling": { "type": "object" },
            "spellSlot": { "type": "boolean" }
          },
          "additionalProperties": true
        },
        "duration": { "type": "object" },
        "range": { "type": "object" },
        "target": { "type": "object" },
        "uses": { "$ref": "#/$defs/uses" },
        "attack": { "type": "object" },
        "damage": { "type": "object" },
        "save": { "type": "object" },
        "roll": { "type": "object" },
        "effects": { "type": "array" }
      }
    },
    "jarvisSemantic": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "identifier": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "uses": { "$ref": "#/$defs/uses" },
        "activities": {
          "type": "array",
          "items": { "$ref": "#/$defs/activity" },
          "default": []
        }
      }
    }
  },
  "type": "object",
  "required": ["schemaVersion", "actor"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "9.0" },
    "actor": {
      "type": "object",
      "required": ["name", "type"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "img": { "type": "string" },
        "imgStrategy": { "$ref": "#/$defs/imgStrategy" },
        "system": { "type": "object" },
        "prototypeToken": { "type": "object" },
        "flags": { "type": "object" }
      },
      "additionalProperties": true
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "minLength": 1 },
          "img": { "type": "string" },
          "imgStrategy": { "$ref": "#/$defs/imgStrategy" },
          "system": { "type": "object" },
          "jarvis": { "$ref": "#/$defs/jarvisSemantic" }
        },
        "additionalProperties": true
      },
      "default": []
    },
    "effects": {
      "type": "array",
      "items": { "type": "object" },
      "default": []
    },
    "meta": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
